# ── AstraCode environment ───────────────────────────────────────────────
# Copy to .env (or run `pnpm setup`, which generates secure local secrets).

# Public URL of the web app (used for CORS and cookie policy)
WEB_ORIGIN=http://localhost:3000

# URL the browser uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:4000

# Repository used by the GitHub button on the dashboard
NEXT_PUBLIC_GITHUB_URL=https://github.com/agyssyy/AstraCODE

# URL the Next.js server uses to reach the API (server-to-server)
API_INTERNAL_URL=http://127.0.0.1:4000

# Fastify API
API_HOST=127.0.0.1
API_PORT=4000

# 32-byte base64 key used to encrypt provider API keys at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Secret used to sign short-lived preview URLs (32+ chars)
PREVIEW_SECRET=

# Optional external PostgreSQL. If empty, AstraCode uses an embedded
# PostgreSQL-compatible database (PGlite) stored in ./data/pg.
DATABASE_URL=

# Where local project workspaces and the embedded database live
ASTRACODE_DATA_DIR=./data

# Set to "production" in production. Cookies are marked Secure when the
# request is served over HTTPS.
NODE_ENV=development

# Gmail/SMTP sender used for two-step verification emails.
# Create a Google App Password (Google Account -> Security -> App passwords)
# and put it in SMTP_PASS. Never use your normal Google password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=
SMTP_FROM="AstraCode <you@gmail.com>"

# Require a 6-digit email code on every login/signup.
# auto = on when SMTP_USER and SMTP_PASS are set, otherwise off.
AUTH_EMAIL_CODE_REQUIRED=auto

# ── Google sign-in (optional) ─────────────────────────────────────────
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console.
# Authorized redirect URI: http://localhost:3000/backend/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override. Defaults to the current web origin + /backend/auth/google/callback.
GOOGLE_REDIRECT_URI=

# ── OpenCode Free (optional) ───────────────────────────────────────────
# Uses a local OpenCode runtime. Disable if OpenCode is not running.
OPENCODE_FREE_ENABLED=true
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_PASSWORD=
OPENCODE_FREE_MODEL=deepseek-v4.1-flash-free
OPENCODE_FREE_LABEL=DeepSeek V4.1 Flash Free
